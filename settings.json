    "ethskills:l2": "off",
    "ethskills:layer2": "off",
    "ethskills:contracts": "off",
    "ethskills:defi": "off",
    "remotion-best-practices": "off",
    "remotion-captions": "off",
    "remotion-create": "off",
    "remotion-docs": "off",
    "remotion-interactivity": "off",
    "remotion-maps": "off",
    "remotion-markup": "off",
    "remotion-multimedia": "off",
    "remotion-render": "off",
    "remotion-saas": "off",
    "remotion-studio": "off",
    "remotion-upgrade": "off",
    "animate-expo": "off",
    "animation-vocabulary": "off",
    "find-animation-opportunities": "off",
    "improve-animations": "off",
    "figma": "off",
    "karpathy": "off",
    "ask-sonner": "off",
    "write-swift": "off",
    "deslop-shared-libs": "off",
    "pick-ui-library": "off",
    "prototype": "off",
    "review-animations": "off",
    "eval-plan": "off",
    "find-skills": "off",
    "render-parity-audit": "off",
    "test-audit": "off",
    "web-design-engineer": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/hooks/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook\"; [ -x \"$f\" ] && \"$f\" || true",
            "timeout": 5
          }
        ],
        "_gstack_source": "gstack-timeline-stop"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'f=$(ls \"$HOME\"/.claude/plugins/cache/caveman/caveman/*/src/hooks/caveman-statusline.sh 2>/dev/null | head -n1); [ -n \"$f\" ] && bash \"$f\"; true'"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ethskills@ethskills": true,
    "interfaces@interfaces": false,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ethskills": {
      "source": {
        "source": "git",
        "url": "https://github.com/austintgriffith/ethskills.git"
      }
    },
    "interfaces": {
      "source": {
        "source": "git",
        "url": "https://github.com/jakubkrehel/skills.git"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized"
}
