    "reveal-hover-effect": "off",
    "schema-markup": "off",
    "seo-audit": "off",
    "service-booking-flow": "off",
    "shaders-cursor-ripples": "off",
    "skeuomorphic-ui": "off",
    "staggered-word-reveal": "off",
    "tailwind": "off",
    "tailwind-v4": "off",
    "thinking-orbs": "off",
    "three": "off",
    "typegpu": "off",
    "vercel-react-best-practices": "off",
    "visual-style-presets": "off",
    "waapi": "off",
    "webgl-laser": "off",
